{
  "timeout": 10000,
  "maxResponseBytes": 5242880,
  "maxRedirects": 5,
  "requestDelay": 500,
  "userAgent": "WebsiteAuditor/0.1 (personal local audit; MVP-1)",
  "respectRobots": true,
  "lighthouse": {
    "enabled": true,
    "formFactor": "mobile",
    "maxWaitForLoad": 45000,
    "saveLhr": false
  },
  "allowedPrivateHosts": [],
  "outputDir": "output",
  "crawl": {
    "enabled": true,
    "maxPages": 25,
    "maxDepth": 3,
    "concurrency": 2,
    "maxDurationMs": 180000,
    "excludePatterns": ["/wp-admin", "/cart", "/checkout"],
    "maxSitemapUrls": 5000,
    "maxSitemaps": 10
  }
}
